{
  "name": "naro-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "test": "node --test src/data/*.test.ts src/demo/*.test.ts src/parity/*.test.ts ../prototype/wallet.test.mjs && node ../prototype/check.mjs",
    "check:design": "node ../design-system/build-tokens.mjs --check && node ../design-system/check-tokens.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts",
    "test:rpc": "node tests/rpc-smoke.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
